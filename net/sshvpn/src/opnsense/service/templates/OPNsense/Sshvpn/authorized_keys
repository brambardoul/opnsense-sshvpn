# Automatically generated by the OPNsense SSH VPN plugin. Do not edit.
#
# no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty,no-user-rc :
#                     lock the key down. NOT "restrict": OpenSSH rejects tun forwarding
#                     for restricted keys (serverloop.c: auth_opts->restricted)
# tunnel="N"        : force server-side tun/tap unit N regardless of what the client asks for
# command="..."     : ignore the Linux "ip addr/ip link" command NetworkManager-ssh sends,
#                     configure the FreeBSD side ourselves instead
{% if helpers.exists('OPNsense.sshvpn.general.enabled') and OPNsense.sshvpn.general.enabled == '1' %}
{%   for client in helpers.toList('OPNsense.sshvpn.clients.client') %}
{%     if client.enabled == '1' and client.pubkey %}
{%       set keyparts = client.pubkey.split() %}
no-port-forwarding,no-agent-forwarding,no-X11-forwarding,no-pty,no-user-rc,tunnel="{{ client.unit }}",command="/usr/local/opnsense/scripts/sshvpn/session.sh {{ client.mode }}{{ client.unit }}" {{ keyparts[0] }} {{ keyparts[1] }} sshvpn-{{ client['@uuid'] }}
{%     endif %}
{%   endfor %}
{% endif %}
